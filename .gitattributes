# Normalise text to LF in the repo; check out Workbench resources as CRLF
* text=auto

*.c       text eol=crlf
*.et      text eol=crlf
*.conf    text eol=crlf
*.layout  text eol=crlf
*.ent     text eol=crlf
*.layer   text eol=crlf
*.meta    text eol=crlf
*.gproj   text eol=crlf
*.st      text eol=crlf
*.imageset text eol=crlf
*.emat    text eol=crlf

# Binary assets — uncomment the LFS lines when custom art/audio is added
# (run `git lfs install` once per machine first)
*.fbx  binary
*.xob  binary
*.edds binary
*.dds  binary
*.tga  binary
*.png  binary
*.psd  binary
*.wav  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
